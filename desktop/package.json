{
  "name": "sublite-desktop-app",
  "version": "1.0.0",
  "main": "main.js",
  "productName": "App",
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "app.sublite.myapp",
    "productName": "App",
    "files": ["main.js", "config.json", "app/**/*", "icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "icon": "icon.png" },
    "portable": { "artifactName": "app.exe" }
  }
}

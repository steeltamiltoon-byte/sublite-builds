  "sourceValue": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" />\n<title>Diamond Wallet - Rewarded Ad</title>\n<style>\n  :root {\n    --bg: #0b1020; \n    --card: #151c34; \n    --line: #243055;\n    --gold: #ffd24a; \n    --cyan: #4ad9ff; \n    --txt: #eaf0ff; \n    --muted: #93a0c4;\n  }\n  * {\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n  }\n  body {\n    margin: 0;\n    min-height: 100vh;\n    background: radial-gradient(120% 90% at 50% 0%, #1b2550 0%, var(--bg) 60%);\n    color: var(--txt);\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 24px;\n    gap: 28px;\n  }\n  .wallet {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    background: var(--card);\n    border: 1px solid var(--line);\n    border-radius: 999px;\n    padding: 12px 22px;\n    font-size: 20px;\n    font-weight: 700;\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);\n  }\n  .wallet span {\n    color: var(--cyan);\n  }\n  .btn {\n    border: 0;\n    cursor: pointer;\n    font: inherit;\n    font-weight: 800;\n    font-size: 19px;\n    color: #10152b;\n    background: linear-gradient(180deg, #ffe084, var(--gold));\n    padding: 20px 38px;\n    border-radius: 18px;\n    box-shadow: 0 14px 34px rgba(255, 210, 74, 0.28);\n    transition: transform 0.12s ease, opacity 0.2s;\n  }\n  .btn:active {\n    transform: scale(0.96);\n  }\n  .btn[disabled] {\n    opacity: 0.55;\n    cursor: not-allowed;\n  }\n  .hint {\n    color: var(--muted);\n    font-size: 13px;\n    text-align: center;\n    max-width: 320px;\n    line-height: 1.5;\n  }\n  /* Fallback Video Player for Browser Testing */\n  #adLayer {\n    position: fixed;\n    inset: 0;\n    background: #000;\n    display: none;\n    flex-direction: column;\n    z-index: 99;\n  }\n  #adLayer.show {\n    display: flex;\n  }\n  #adVideo {\n    flex: 1;\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    background: #000;\n  }\n  #adBar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 12px 16px;\n    background: #0e1326;\n    font-size: 14px;\n  }\n  #skipBtn {\n    background: #243055;\n    color: var(--txt);\n    border: 0;\n    border-radius: 10px;\n    padding: 10px 16px;\n    font-weight: 700;\n  }\n  #skipBtn[disabled] {\n    opacity: 0.5;\n  }\n  .pop {\n    position: fixed;\n    left: 50%;\n    top: 22%;\n    transform: translateX(-50%);\n    background: var(--card);\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 14px 20px;\n    font-weight: 700;\n    display: none;\n    z-index: 120;\n  }\n  .pop.show {\n    display: block;\n    animation: up 0.35s ease;\n  }\n  @keyframes up {\n    from { opacity: 0; transform: translate(-50%, 14px); }\n    to { opacity: 1; transform: translate(-50%, 0); }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"wallet\">💎 Diamonds: <span id=\"count\">0</span></div>\n\n<button class=\"btn\" id=\"watchBtn\">▶ Watch Ad &amp; Get 1 💎</button>\n\n<p class=\"hint\" id=\"status\">\n  Testing Mode Active<br>\n  AdMob Rewarded Unit Connected\n</p>\n\n<!-- Fallback Ad Layer for Web Browser -->\n<div id=\"adLayer\">\n  <video id=\"adVideo\" playsinline webkit-playsinline preload=\"auto\"></video>\n  <div id=\"adBar\">\n    <span id=\"adTimer\">Ad</span>\n    <button id=\"skipBtn\" disabled>Close</button>\n  </div>\n</div>\n\n<div class=\"pop\" id=\"pop\">+1 💎 Reward added!</div>\n\n<script>\n/* ---------------- Wallet System ---------------- */\nvar KEY = \"diamond_wallet_v1\";\nvar diamonds = parseInt(localStorage.getItem(KEY) || \"0\", 10) || 0;\nvar countEl = document.getElementById(\"count\");\nvar statusEl = document.getElementById(\"status\");\nvar btn = document.getElementById(\"watchBtn\");\nvar pop = document.getElementById(\"pop\");\n\nrender();\n\nfunction render() { \n  countEl.textContent = diamonds; \n}\n\nfunction grantReward() {\n  diamonds += 1;\n  localStorage.setItem(KEY, String(diamonds));\n  render();\n  pop.classList.add(\"show\");\n  setTimeout(function() { \n    pop.classList.remove(\"show\"); \n  }, 1600);\n  btn.disabled = false;\n  btn.textContent = \"▶ Watch Ad & Get 1 💎\";\n  statusEl.textContent = \"Reward granted successfully!\";\n}\n\nfunction adFailed(msg) {\n  btn.disabled = false;\n  btn.textContent = \"▶ Watch Ad & Get 1 💎\";\n  statusEl.textContent = msg || \"Ad not completed — no reward.\";\n}\n\n/* Native Android Bridge Handlers */\nwindow.onAdRewarded = grantReward;\nwindow.onAdClosedWithoutReward = function() { \n  adFailed(\"Ad closed early — no diamond.\"); \n};\nwindow.onAdFailed = function(m) { \n  adFailed(\"Ad failed to load: \" + (m || \"no fill\")); \n};\n\n/* ---------------- Ad Logic ---------------- */\nbtn.addEventListener(\"click\", function() {\n  btn.disabled = true;\n  btn.textContent = \"Loading ad…\";\n\n  // Official AdMob Test Rewarded Ad Unit ID\n  var TEST_REWARDED_ID = \"ca-app-pub-3940256099942544/5224354917\";\n\n  // 1) Check for Android Native JavascriptInterface (named \"AndroidAds\" or \"Android\")\n  if (window.AndroidAds && typeof window.AndroidAds.showRewardedAd === \"function\") {\n    try { \n      window.AndroidAds.showRewardedAd(TEST_REWARDED_ID); \n      return; \n    } catch(e) { /* fall through to fallback */ }\n  } else if (window.Android && typeof window.Android.showRewardedAd === \"function\") {\n    try { \n      window.Android.showRewardedAd(TEST_REWARDED_ID); \n      return; \n    } catch(e) { /* fall through to fallback */ }\n  }\n\n  // 2) Browser Fallback (If tested directly in mobile Chrome/WebView without native code)\n  playFallbackAd();\n});\n\n/* ---------------- Fallback Video Ad ---------------- */\nvar layer = document.getElementById(\"adLayer\");\nvar video = document.getElementById(\"adVideo\");\nvar timer = document.getElementById(\"adTimer\");\nvar skip  = document.getElementById(\"skipBtn\");\nvar completed = false;\n\nvar AD_VIDEO = \"https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerJoyrides.mp4\";\n\nfunction playFallbackAd() {\n  completed = false;\n  skip.disabled = true;\n  layer.classList.add(\"show\");\n  video.src = AD_VIDEO;\n  video.currentTime = 0;\n  video.muted = false;\n  var p = video.play();\n  if (p && p.catch) {\n    p.catch(function() { \n      video.muted = true; \n      video.play(); \n    });\n  }\n}\n\nvideo.addEventListener(\"timeupdate\", function() {\n  if (!isFinite(video.duration)) return;\n  var left = Math.max(0, Math.ceil(video.duration - video.currentTime));\n  timer.textContent = completed ? \"Ad finished\" : \"Reward in \" + left + \"s\";\n});\n\nvideo.addEventListener(\"ended\", function() {\n  completed = true;\n  timer.textContent = \"Ad finished ✔\";\n  skip.disabled = false;\n});\n\nskip.addEventListener(\"click\", closeAd);\n\nfunction closeAd() {\n  video.pause();\n  layer.classList.remove(\"show\");\n  video.removeAttribute(\"src\");\n  if (completed) {\n    grantReward();\n  } else {\n    adFailed(\"Ad closed early — no diamond.\");\n  }\n}\n</script>\n</body>\n</html>",
  "icon": null
}